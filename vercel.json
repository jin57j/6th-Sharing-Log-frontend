{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://sharinglog-env.eba-mitpdzez.ap-northeast-2.elasticbeanstalk.com/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "http://sharinglog-env.eba-mitpdzez.ap-northeast-2.elasticbeanstalk.com/oauth2/:path*"
    },
    {
      "source": "/login/:path*",
      "destination": "http://sharinglog-env.eba-mitpdzez.ap-northeast-2.elasticbeanstalk.com/login/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
